<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abc123.hsp.mapper.PaymentLogMapper">

    <sql id="paymentLogWhere">
        <where>
            <if test="query.paymentOrderId != null and query.paymentOrderId != ''">
                payment_order_id LIKE CONCAT('%', #{query.paymentOrderId}, '%')
            </if>
            <if test="query.orderNo != null and query.orderNo != ''">
                AND order_no LIKE CONCAT('%', #{query.orderNo}, '%')
            </if>
            <if test="query.processStage != null and query.processStage != '' and query.processStage != '全部'">
                AND process_stage = #{query.processStage}
            </if>
            <if test="query.logLevel != null and query.logLevel != '' and query.logLevel != '全部'">
                AND log_level = #{query.logLevel}
            </if>
            <if test="query.source != null and query.source != ''">
                AND source LIKE CONCAT('%', #{query.source}, '%')
            </if>
            <if test="query.keyword != null and query.keyword != ''">
                AND message LIKE CONCAT('%', #{query.keyword}, '%')
            </if>
        </where>
    </sql>

    <sql id="paymentLogColumns">
        log_no AS logNo,
        payment_order_id AS paymentOrderId,
        order_no AS orderNo,
        process_stage AS processStage,
        log_level AS logLevel,
        log_level_type AS logLevelType,
        message,
        source,
        DATE_FORMAT(created_at, '%Y-%m-%d %H:%i:%s') AS createdAt
    </sql>

    <sql id="paymentLogOrder">
        <choose>
            <when test="query.sortField == 'logLevel'">
                ORDER BY log_level
            </when>
            <when test="query.sortField == 'processStage'">
                ORDER BY process_stage
            </when>
            <otherwise>
                ORDER BY created_at
            </otherwise>
        </choose>
        <choose>
            <when test="query.sortOrder == 'asc'">
                ASC, id ASC
            </when>
            <otherwise>
                DESC, id DESC
            </otherwise>
        </choose>
    </sql>

    <select id="findAll" resultType="com.abc123.hsp.dto.PaymentLogListItemDTO">
        SELECT <include refid="paymentLogColumns"/>
        FROM t_payment_process_log
        <include refid="paymentLogWhere"/>
        <include refid="paymentLogOrder"/>
        LIMIT #{query.limit} OFFSET #{query.offset}
    </select>

    <select id="findAllForExport" resultType="com.abc123.hsp.dto.PaymentLogListItemDTO">
        SELECT <include refid="paymentLogColumns"/>
        FROM t_payment_process_log
        <include refid="paymentLogWhere"/>
        <include refid="paymentLogOrder"/>
        LIMIT 1001
    </select>

    <select id="findOverviewSummary" resultType="com.abc123.hsp.dto.PaymentLogOverviewDTO">
        SELECT COUNT(1) AS totalLogCount,
               COALESCE(SUM(CASE WHEN log_level = 'ERROR' THEN 1 ELSE 0 END), 0) AS errorLogCount,
               COALESCE(SUM(CASE WHEN log_level = 'WARN' THEN 1 ELSE 0 END), 0) AS warnLogCount,
               COALESCE(SUM(CASE WHEN log_level = 'INFO' THEN 1 ELSE 0 END), 0) AS infoLogCount,
               COUNT(DISTINCT process_stage) AS distinctStageCount,
               COUNT(DISTINCT source) AS distinctSourceCount,
               COALESCE(SUM(CASE WHEN process_stage = '渠道回调' AND log_level = 'ERROR' THEN 1 ELSE 0 END), 0)
                   AS callbackErrorCount,
               COALESCE(SUM(CASE WHEN process_stage = '业务事件' AND log_level = 'WARN' THEN 1 ELSE 0 END), 0)
                   AS eventWarnCount,
               COALESCE(SUM(CASE WHEN message LIKE '%回调%' THEN 1 ELSE 0 END), 0) AS callbackKeywordCount,
               DATE_FORMAT(MAX(created_at), '%Y-%m-%d %H:%i:%s') AS latestLogAt
        FROM t_payment_process_log
        <include refid="paymentLogWhere"/>
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(1)
        FROM t_payment_process_log
        <include refid="paymentLogWhere"/>
    </select>
</mapper>
