.result-summary {
  text-align: center;
}

.result-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff7d6;
  color: #92400e;
  font-size: 46rpx;
  font-weight: 700;
}

.result-success .result-mark {
  background: #dcfce7;
  color: #166534;
}

.result-danger .result-mark {
  background: #fee2e2;
  color: #b91c1c;
}

.result-summary .section-title,
.result-summary .page-subtitle {
  margin-bottom: 0;
  margin-top: 0;
}
