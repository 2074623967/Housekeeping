.refund-summary {
  text-align: center;
}

.refund-summary .section-title,
.refund-summary .page-subtitle {
  margin-top: 0;
  margin-bottom: 0;
}

.refund-success .result-mark {
  background: #dcfce7;
  color: #166534;
}

.refund-danger .result-mark {
  background: #fee2e2;
  color: #b91c1c;
}

.result-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff7d6;
  color: #92400e;
  font-size: 46rpx;
  font-weight: 700;
}

.timeline-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e5e9ed;
}

.timeline-item:last-child {
  border-bottom: 0;
}

.timeline-title {
  font-weight: 700;
}

.timeline-detail {
  margin-top: 8rpx;
  color: #607080;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.timeline-empty {
  margin: 0;
  padding: 28rpx 0;
}
