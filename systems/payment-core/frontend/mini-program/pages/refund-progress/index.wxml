<view class="page-shell">
  <view class="page-header">
    <view class="eyebrow">REFUND PROGRESS</view>
    <view class="page-title">{{meta.title}}</view>
    <view class="page-subtitle">{{meta.hint}} 用户端只提供只读查询，不执行审核或失败重试。</view>
  </view>

  <view wx:if="{{loading}}" class="panel empty-state">退款进度加载中...</view>
  <view wx:elif="{{!detail}}" class="panel">
    <view class="error-banner">{{errorMessage || '当前没有可用退款进度快照'}}</view>
    <button class="secondary-button" bindtap="backToEntry">返回业务入口</button>
  </view>
  <block wx:else>
    <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>
    <view wx:if="{{successMessage}}" class="success-banner">{{successMessage}}</view>

    <view class="panel refund-summary refund-{{meta.tone}}">
      <view class="result-mark">{{meta.tone === 'success' ? '✓' : meta.tone === 'danger' ? '!' : '…'}}</view>
      <view class="section-title">{{detail.status}}</view>
      <view class="page-subtitle">退款单 {{detail.refundOrderId}}</view>
    </view>

    <view class="panel">
      <view class="section-title">退款详情</view>
      <view class="detail-list">
        <view class="detail-row"><text class="detail-label">退款金额</text><text class="detail-value">{{detail.refundAmount || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">原支付单号</text><text class="detail-value">{{detail.paymentOrderId || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">原订单号</text><text class="detail-value">{{detail.orderNo || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">退款方式</text><text class="detail-value">{{detail.refundMethod || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">退款原因</text><text class="detail-value">{{detail.refundReason || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">申请时间</text><text class="detail-value">{{detail.appliedAt || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">成功时间</text><text class="detail-value">{{detail.successAt || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">退款渠道</text><text class="detail-value">{{detail.channelCode || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">渠道退款单号</text><text class="detail-value">{{detail.channelRefundNo || '-'}}</text></view>
      </view>
    </view>

    <view class="panel">
      <view class="section-title">退款轨迹</view>
      <view wx:for="{{timeline}}" wx:key="key" class="timeline-item">
        <view class="timeline-title">{{item.title}}</view>
        <view class="timeline-detail">{{item.time}} / {{item.detail}}</view>
      </view>
      <view wx:if="{{!timeline.length}}" class="empty-state timeline-empty">当前暂无退款轨迹</view>
    </view>

    <view class="panel">
      <view class="button-row button-row-single">
        <button class="primary-button" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="refreshDetail">{{refreshing ? '刷新中...' : '刷新退款进度'}}</button>
        <button class="secondary-button" disabled="{{refreshing}}" bindtap="backToEntry">返回业务入口</button>
      </view>
    </view>
  </block>
</view>
