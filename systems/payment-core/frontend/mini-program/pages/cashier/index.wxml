<view class="page-shell">
  <view class="page-header">
    <view class="eyebrow">MINI PROGRAM CASHIER</view>
    <view class="page-title">{{scene.title}}收银台</view>
    <view class="page-subtitle">小程序仅支持微信支付提交；已受理订单展示原支付方式。</view>
  </view>

  <view wx:if="{{loading}}" class="panel empty-state">收银台加载中...</view>
  <view wx:elif="{{!cashier}}" class="panel">
    <view class="error-banner">{{errorMessage || '当前没有可用收银台快照'}}</view>
    <button class="secondary-button" bindtap="backToEntry">返回业务入口</button>
  </view>
  <block wx:else>
    <view wx:if="{{errorMessage}}" class="error-banner">{{errorMessage}}</view>
    <view wx:if="{{channelTransactionConflict}}" class="error-banner">渠道流水归属冲突，需人工核对渠道原始事实与流水归属；请勿重复付款、主动查单或关闭支付单。可手动刷新收银台。</view>

    <view class="panel amount-panel">
      <view class="field-label">本次应付</view>
      <view class="cashier-amount">{{cashier.amount || '¥0.00'}}</view>
      <view class="status-pill {{staleCashier ? 'status-warn' : statusClass}}">{{staleCashier ? '待核查' : cashier.status}}</view>
    </view>

    <view class="panel">
      <view class="section-title">交易信息</view>
      <view class="detail-list">
        <view class="detail-row"><text class="detail-label">预付单号</text><text class="detail-value">{{cashier.prepayOrderNo}}</text></view>
        <view class="detail-row"><text class="detail-label">支付单号</text><text class="detail-value">{{cashier.paymentOrderId || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">业务订单</text><text class="detail-value">{{cashier.orderNo || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">账单号</text><text class="detail-value">{{cashier.billNo || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">客户名称</text><text class="detail-value">{{cashier.customerName || '-'}}</text></view>
        <view wx:if="{{cashier.channelTransactionNo}}" class="detail-row"><text class="detail-label">原渠道流水号</text><text class="detail-value">{{cashier.channelTransactionNo}}</text></view>
        <view class="detail-row"><text class="detail-label">最近尝试完成时间</text><text class="detail-value">{{cashier.latestAttemptCompletedAt || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">失效时间（北京时间）</text><text class="detail-value">{{cashier.expiresAt || '-'}}</text></view>
        <view class="detail-row"><text class="detail-label">剩余时间</text><text class="detail-value">{{countdownLabel}}</text></view>
      </view>
    </view>

    <view class="panel">
      <view class="section-title">支付方式</view>
      <view wx:if="{{staleCashier}}" class="error-banner">当前仅展示上次收银台快照，刷新确认前请勿重复付款。</view>
      <view class="payment-channel {{(cashier.paymentMethod || cashier.reviewPaymentMethod) && (cashier.paymentMethod || cashier.reviewPaymentMethod) !== '微信支付' ? 'other-channel' : ''}}">
        <view class="payment-mark">{{(cashier.paymentMethod || cashier.reviewPaymentMethod) && (cashier.paymentMethod || cashier.reviewPaymentMethod) !== '微信支付' ? '支' : '微'}}</view>
        <view class="channel-copy">
          <view class="channel-name">{{cashier.paymentMethod || cashier.reviewPaymentMethod || '微信支付'}}</view>
          <view wx:if="{{cashier.paymentMethod}}" class="channel-hint">原支付渠道：{{cashier.channel}}</view>
          <view wx:elif="{{cashier.reviewPaymentMethod}}" class="channel-hint">风控复核渠道：{{cashier.reviewChannelCode || '-'}}</view>
          <view wx:else class="channel-hint">来源策略：housekeeping-mini-program</view>
        </view>
        <view class="selected-dot"></view>
      </view>

      <view class="idempotency-box">
        <view class="field-label">本次幂等键</view>
        <view class="idempotency-key">{{idempotencyKey}}</view>
        <view class="channel-hint">同一预付单使用固定键；支付结果未明时请先核对，不要重新发起新交易。</view>
      </view>

      <view class="button-row button-row-single">
        <button class="primary-button" loading="{{actionName === 'submit'}}" disabled="{{!canSubmit || loading || actionName}}" bindtap="submitPayment">
          {{actionName === 'submit' ? '提交中...' : channelTransactionConflict ? '人工核查中' : cashier.paymentStatus === 'WAIT_CALLBACK' ? '等待原渠道回调' : cashier.paymentStatus === 'SUCCESS' ? '支付已完成' : cashier.paymentStatus === 'RISK_REVIEW' ? '审核通过后继续原支付' : '确认微信支付'}}
        </button>
        <button class="secondary-button" disabled="{{loading || actionName}}" bindtap="loadCashier">刷新收银台</button>
        <button class="secondary-button" disabled="{{actionName}}" bindtap="backToEntry">返回业务入口</button>
      </view>
    </view>
  </block>
</view>
