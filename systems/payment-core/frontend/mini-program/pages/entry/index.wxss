.scene-tabs {
  width: 100%;
  margin-bottom: 22rpx;
  white-space: nowrap;
}

.scene-tab {
  display: inline-flex;
  width: auto;
  min-width: 144rpx;
  min-height: 68rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #cbd5df;
  border-radius: 8rpx;
  background: #ffffff;
  color: #475569;
  font-size: 26rpx;
}

.scene-tab-active {
  border-color: #0f766e;
  background: #0f766e;
  color: #ffffff;
}

.scene-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.scene-summary .section-title,
.scene-summary .page-subtitle {
  margin-bottom: 0;
  margin-top: 0;
}

.amount-preview {
  flex: none;
  color: #b45309;
  font-size: 42rpx;
  font-weight: 700;
}
