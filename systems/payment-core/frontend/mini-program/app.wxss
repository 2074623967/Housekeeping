page {
  background: #f4f6f8;
  color: #17212b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 18rpx 4rpx 30rpx;
}

.eyebrow {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
}

.page-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #607080;
  line-height: 1.6;
}

.panel {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #dce2e7;
  border-radius: 12rpx;
  background: #ffffff;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.field {
  display: block;
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #475569;
  font-size: 25rpx;
  font-weight: 600;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #cbd5df;
  border-radius: 8rpx;
  background: #ffffff;
  color: #17212b;
}

.field-input {
  height: 82rpx;
  padding: 0 22rpx;
}

.field-textarea {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
}

.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  margin: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.primary-button {
  background: #0f766e;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #b8c2cc;
  background: #ffffff;
  color: #273444;
}

.danger-button {
  border: 1rpx solid #dc2626;
  background: #ffffff;
  color: #b91c1c;
}

button[disabled] {
  opacity: 0.45;
}

.button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.button-row-single {
  grid-template-columns: 1fr;
}

.status-banner,
.error-banner,
.success-banner {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 8rpx;
  line-height: 1.55;
}

.status-banner {
  background: #edf6f5;
  color: #115e59;
}

.error-banner {
  background: #fef2f2;
  color: #b91c1c;
}

.success-banner {
  background: #f0fdf4;
  color: #166534;
}

.empty-state {
  padding: 56rpx 20rpx;
  color: #64748b;
  text-align: center;
}

.detail-list {
  border-top: 1rpx solid #e5e9ed;
}

.detail-row {
  display: grid;
  grid-template-columns: 190rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e5e9ed;
}

.detail-label {
  color: #64748b;
}

.detail-value {
  min-width: 0;
  text-align: right;
  word-break: break-all;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}

.status-success {
  background: #dcfce7;
  color: #166534;
}

.status-warn {
  background: #fff7d6;
  color: #92400e;
}

.status-danger {
  background: #fee2e2;
  color: #b91c1c;
}
